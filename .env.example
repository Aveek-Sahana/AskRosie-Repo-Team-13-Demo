# Server-only provider credentials. Never use VITE_ prefixes for these values.
GROQ_API_KEY=your-groq-key-here
NVIDIA_API_KEY=your-nvidia-key-here

# Vercel/Render production request origin. Set to the exact HTTPS public URL.
ALLOWED_ORIGIN=https://your-production-domain.example

# Optional server-side model overrides.
GROQ_MODEL=qwen/qwen3.6-27b
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
